#
# Vorlage für die Konfiguration über Umgebungsvariablen. Echte Werte gehören nie ins
# Repository (CLAUDE.md, Sicherheit); diese Datei enthält nur Platzhalter.
# Die Datenbank lauscht nur auf 127.0.0.1 (Fachkonzept 11.1).

# Anwendung: Laufzeitrolle, darf auf buchung und posting nur lesen und einfügen (E-19).
FINANZMANAGER_DATABASE_URL=postgresql+psycopg://finanzmanager_app:<passwort>@127.0.0.1:5432/finanzmanager

# Migrationen (alembic upgrade head): Eigentümerrolle der Tabellen.
FINANZMANAGER_MIGRATION_DATABASE_URL=postgresql+psycopg://finanzmanager_owner:<passwort>@127.0.0.1:5432/finanzmanager

# Nur für das Bootstrap-Skript (python -m app.kern.db.bootstrap): Superuser, legt Rollen
# und Datenbank an. Danach nicht mehr nötig.
FINANZMANAGER_ADMIN_DATABASE_URL=postgresql+psycopg://postgres:<passwort>@127.0.0.1:5432/postgres

# Nur für Tests: Superuser eines eigenen PostgreSQL 16 nur für Tests (hier Port 5433), auf
# dem die Tests eigene Datenbanken fm_test_<zufall> anlegen und wieder löschen. Nie der
# Cluster einer echten Instanz: Die Tests setzen die Rollenpasswörter neu (CONTRIBUTING.md,
# Abschnitt „Test-Datenbank“).
FINANZMANAGER_TEST_ADMIN_DATABASE_URL=postgresql+psycopg://postgres:<passwort>@127.0.0.1:5433/postgres

# Optional für Tests: Profil der Property-Tests mit Datenbank (db-gruendlich oder db-ci).
FINANZMANAGER_HYPOTHESIS_DB_PROFIL=db-gruendlich
